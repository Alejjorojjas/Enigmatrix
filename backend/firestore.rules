rules_version = '2';

// Reglas de Enigmatrix (etapa 5A.3). Por defecto todo está denegado;
// solo se abre lo que aparece aquí. Las escrituras las hacen las Cloud Functions
// con Admin, que no pasan por estas reglas.
// Las soluciones de los casos no están en Firestore: viven dentro de las funciones.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Usuario y progreso: el dueño lee; solo las funciones escriben.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /progress/{caseId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Ranking del día: lo lee cualquier usuario con sesión; solo las funciones escriben.
    match /dailyRankings/{date}/entries/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Valores del servidor: solo Admin.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
